# ── Entorno ───────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Base de datos (PgBouncer — runtime) ───────────────────────
# ?pgbouncer=true deshabilita prepared statements (obligatorio en transaction mode)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:6432/xchanger?pgbouncer=true&sslmode=disable"

# ── Base de datos (PostgreSQL directo — migraciones) ──────────
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/xchanger?sslmode=disable"

# ── JWT ───────────────────────────────────────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_LARGO_Y_ALEATORIO_DE_AL_MENOS_32_CHARS
JWT_REFRESH_SECRET=CAMBIA_ESTO_POR_OTRO_SECRETO_LARGO_Y_ALEATORIO_DIFERENTE
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Sesión con "Recordar inicio de sesión" (cookie persistente)
JWT_REFRESH_REMEMBER_EXPIRES_IN=30d
JWT_OTP_EXPIRES_IN=30m

# ── CORS ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Email (Nodemailer) ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=tu-app-password
SMTP_FROM=tu-cuenta@gmail.com

# ── Escalado: canal Telegram y MFA (§12.3) ────────────────────
# Redis: bus de eventos, límites de intentos, idempotencia y adaptador de sockets
REDIS_URL=redis://localhost:6379/0
# Firma de los tokens de canal (≥ 32 caracteres, distinto de los anteriores)
JWT_CHANNEL_SECRET=CAMBIA_ESTO_POR_UN_TERCER_SECRETO_LARGO_Y_ALEATORIO
CHANNEL_REFRESH_IDLE_DAYS=30
CHANNEL_REFRESH_ABSOLUTE_DAYS=180
CHANNEL_LINK_BASE_URL=http://localhost/vincular
# Clave ES256 (PEM PKCS#8, saltos de línea como \n) para firmar JWT de servicio.
# Obligatoria en producción. Genera con:
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 | awk 1 ORS='\\n'
SERVICE_JWT_PRIVATE_KEY=
SERVICE_JWT_KID=core-2026-11
# Clientes de servicio: el secreto se guarda como SHA-256 (hex), nunca en claro.
#   printf '%s' "$SECRETO_DEL_BOT" | sha256sum
SERVICE_CLIENTS='[{"clientId":"telegram-bot","secretSha256":"<sha256-hex>","scopes":["channel:telegram"]}]'
# Cliente del mfa-service
MFA_SERVICE_URL=http://mfa:8081
MFA_TIMEOUT_MS=2000
# true en producción: el alta de MFA (QR) solo se permite por HTTPS.
# docker-compose lo sobreescribe con MFA_REQUIRE_HTTPS del .env raíz.
MFA_REQUIRE_HTTPS=true
# Saltos de proxy de confianza (Nginx) para req.ip (AR-02)
TRUST_PROXY_HOPS=1
# Intervalo del publicador del outbox (ms)
OUTBOX_POLL_MS=250
