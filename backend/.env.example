# ── Entorno ───────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Base de datos (PgBouncer — runtime) ───────────────────────
# ?pgbouncer=true deshabilita prepared statements (obligatorio en transaction mode)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:6432/xchanger?pgbouncer=true&sslmode=disable"

# ── Base de datos (PostgreSQL directo — migraciones) ──────────
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/xchanger?sslmode=disable"

# ── JWT ───────────────────────────────────────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_LARGO_Y_ALEATORIO_DE_AL_MENOS_32_CHARS
JWT_REFRESH_SECRET=CAMBIA_ESTO_POR_OTRO_SECRETO_LARGO_Y_ALEATORIO_DIFERENTE
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_OTP_EXPIRES_IN=30m

# ── CORS ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Email (Nodemailer) ────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=tu-app-password
SMTP_FROM=tu-cuenta@gmail.com
