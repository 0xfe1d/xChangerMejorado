# ── Entorno ────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Base de datos — PostgreSQL directo (dev sin PgBouncer) ─────
# En producción usar: postgresql://...@pgbouncer:5432/...?pgbouncer=true
DATABASE_URL="postgresql://xchanger:xchanger_dev_pass@localhost:5432/xchanger?sslmode=disable"
DIRECT_URL="postgresql://xchanger:xchanger_dev_pass@localhost:5432/xchanger?sslmode=disable"

# ── JWT ────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=xchanger_access_secret_32_chars_minimum_dev
JWT_REFRESH_SECRET=xchanger_refresh_secret_32_chars_minimum_dev
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_OTP_EXPIRES_IN=30m

# ── CORS ───────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Email (Nodemailer) — Ethereal para dev (no envía emails reales)
# Reemplaza con credenciales SMTP reales en producción
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=false
SMTP_USER=cambio.grupos.informatica@gmail.com
SMTP_PASS=gqmf dmjb uqzc cfrh 
SMTP_FROM=cambio.grupos.informatica@gmail.com
