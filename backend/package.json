{
  "name": "xchanger-backend",
  "version": "1.0.0",
  "private": true,
  "description": "xChanger backend — Node.js/Express API + Socket.io",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts",
    "lint": "eslint 'src/**/*.ts'",
    "test": "jest --selectProjects unit",
    "test:integration": "docker compose -f docker-compose.test.yml up -d --wait && jest --selectProjects integration --runInBand",
    "test:e2e": "./e2e/run-e2e.sh",
    "test:all": "npm test && npm run test:integration && npm run test:e2e"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "geoip-lite": "^2.0.3",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.13",
    "socket.io": "^4.7.5",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/geoip-lite": "^1.4.4",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.15",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^5.14.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true,
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "@prisma/client@5.22.0": true
  }
}
