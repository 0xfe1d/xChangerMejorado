@startuml uc03-web-administracion
!include _estilo.iuml
left to right direction
title Casos de uso — Interfaz web: administración

actor "Estudiante" as E
actor "Embajador" as EMB
actor "Propietario" as P
actor "Servidor SMTP" as SMTP <<sistema>>
actor "mfa-service" as MFA <<sistema>>
E <|-- EMB
EMB <|-- P

rectangle "xChanger" {
  package "Ámbito del administrador" {
    usecase "UC-50 Atender tickets del ámbito" as UC50
    usecase "UC-51 Gestionar cursos" as UC51
    usecase "UC-52 Gestionar asignaturas" as UC52
    usecase "UC-53 Gestionar grupos" as UC53
    usecase "UC-54 Confirmar eliminación\ncon referencias" as UC54
    usecase "UC-55 Buscar usuarios" as UC55
    usecase "UC-56 Consultar detalle de usuario" as UC56
    usecase "UC-57 Bloquear usuario" as UC57
    usecase "UC-58 Desbloquear usuario" as UC58
    usecase "UC-59 Forzar cambio de contraseña" as UC59
    usecase "UC-60 Restablecer MFA de usuario" as UC60
    usecase "UC-61 Auditar el log" as UC61
  }
  package "Solo Propietario" {
    usecase "UC-70 Gestionar carreras" as UC70
    usecase "UC-71 Promover a embajador" as UC71
    usecase "UC-72 Degradar embajador" as UC72
    usecase "UC-73 Modificar ámbito" as UC73
  }
}

EMB -- UC50
EMB -- UC51
EMB -- UC52
EMB -- UC53
EMB -- UC55
EMB -- UC56
EMB -- UC57
EMB -- UC58
EMB -- UC59
EMB -- UC60
EMB -- UC61
P -- UC70
P -- UC71
P -- UC72
P -- UC73

UC54 .> UC51 : <<extend>>
UC54 .> UC52 : <<extend>>
UC54 .> UC53 : <<extend>>
UC54 .> UC70 : <<extend>>
UC57 .> UC55 : <<include>>
UC71 .> UC55 : <<include>>

UC54 -- SMTP
UC57 -- SMTP
UC60 -- MFA

note bottom of UC57
  Un Embajador solo actúa sobre Estudiantes
  de su ámbito; nadie sobre un Propietario
  ni sobre sí mismo (RF-BLQ-02).
end note
@enduml
