---
import AuthLayout from '../layouts/AuthLayout.astro';
import { serverApi, type UserMe } from '../lib/api';
const api = serverApi(Astro.request);

// Solo rutas internas como destino tras el login (evita redirecciones abiertas)
const rawNext = Astro.url.searchParams.get('next') ?? '';
const next = rawNext.startsWith('/') && !rawNext.startsWith('//') && !rawNext.startsWith('/login') ? rawNext : '/dashboard';

// Redirigir si ya está autenticado
try {
  await api.get<UserMe>('/auth/me');
  return Astro.redirect(next);
} catch {
  // No autenticado → mostrar login
}
---

<AuthLayout title="Iniciar sesión">
  <div class="rounded-2xl border border-gray-200 bg-white px-8 py-10 shadow-sm">
    <h1 class="mb-1 text-2xl font-bold text-gray-900">Bienvenido/a</h1>
    <p class="mb-8 text-sm text-gray-500">
      Inicia sesión con tu cuenta de xChanger.
    </p>

    <!-- Error global -->
    <div
      id="error-banner"
      role="alert"
      aria-live="polite"
      class="mb-5 hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"
    ></div>

    <!-- Modal de bloqueo -->
    <div
      id="blocked-modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="blocked-title"
      class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4"
    >
      <div class="w-full max-w-md rounded-2xl bg-white p-8 shadow-xl">
        <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-red-100">
          <svg class="h-6 w-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
          </svg>
        </div>
        <h2 id="blocked-title" class="mb-2 text-lg font-bold text-gray-900">Cuenta bloqueada</h2>
        <p id="blocked-reason" class="mb-2 text-sm text-gray-600"></p>
        <p id="blocked-until" class="mb-6 text-sm font-medium text-red-600"></p>
        <button
          id="blocked-close"
          type="button"
          class="btn-primary w-full"
        >
          Entendido
        </button>
      </div>
    </div>

    <form id="login-form" novalidate class="space-y-5" data-next={next}>
      <div>
        <label for="email" class="mb-1.5 block text-sm font-medium text-gray-700">
          Email institucional
        </label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          required
          placeholder="tu@alumnos.unican.es"
          class="input-field"
        />
        <p id="email-error" class="mt-1 hidden text-xs text-red-600"></p>
      </div>

      <div>
        <label for="password" class="mb-1.5 block text-sm font-medium text-gray-700">
          Contraseña
        </label>
        <div class="relative">
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="current-password"
            required
            class="input-field pr-10"
          />
          <button
            type="button"
            id="toggle-password"
            aria-label="Mostrar/ocultar contraseña"
            class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600"
          >
            <svg id="eye-icon" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.964-7.178z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </button>
        </div>
        <p id="password-error" class="mt-1 hidden text-xs text-red-600"></p>
      </div>

      <label for="remember-me" class="flex cursor-pointer select-none items-center gap-2 text-sm text-gray-700">
        <input id="remember-me" name="rememberMe" type="checkbox"
               class="h-4 w-4 rounded border-gray-300 text-brand focus:ring-brand/40" />
        Recordar inicio de sesión durante 30 días
      </label>

      <div class="flex items-center justify-between">
        <button type="submit" id="submit-btn" class="btn-primary flex-1">
          Iniciar sesión
        </button>
      </div>
      <p class="text-center text-sm">
        <button type="button" id="forgot-password-link" class="text-brand hover:underline font-medium">
          ¿Olvidaste tu contraseña?
        </button>
      </p>
    </form>

    <!-- Segundo paso: verificación en dos pasos (MFA) -->
    <form id="mfa-form" novalidate class="hidden space-y-5">
      <div class="rounded-lg border border-blue-100 bg-blue-50 px-4 py-3 text-sm text-blue-800">
        <span id="mfa-hint-app">Abre tu app de autenticación (Microsoft Authenticator, Google Authenticator…) e introduce el código de 6 dígitos de xChanger.</span>
        <span id="mfa-hint-recovery" class="hidden">Introduce uno de tus códigos de recuperación (formato XXXXX-XXXXX). Cada código solo se puede usar una vez.</span>
      </div>
      <div>
        <label id="mfa-code-label" for="mfa-code" class="mb-1.5 block text-sm font-medium text-gray-700">Código de verificación</label>
        <input id="mfa-code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="7"
               placeholder="123456" class="input-field text-center text-lg tracking-widest" />
        <p id="mfa-error" class="mt-1 hidden text-xs text-red-600"></p>
      </div>
      <button type="submit" id="mfa-submit" class="btn-primary w-full">Verificar</button>
      <div class="flex items-center justify-between text-sm">
        <button type="button" id="mfa-back" class="font-medium text-gray-500 hover:underline">← Volver</button>
        <button type="button" id="mfa-toggle" class="font-medium text-brand hover:underline">Usar un código de recuperación</button>
      </div>
    </form>

    <p id="register-link" class="mt-6 text-center text-sm text-gray-500">
      ¿No tienes cuenta?{' '}
      <a href="/register" class="font-medium text-brand hover:underline">
        Regístrate
      </a>
    </p>
  </div>

  <!-- Modal recuperación de contraseña -->
  <div id="forgot-modal" role="dialog" aria-modal="true" aria-labelledby="forgot-title"
       class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4">
    <div class="w-full max-w-md rounded-2xl bg-white p-8 shadow-xl">
      <!-- Step 1: solicitar email -->
      <div id="forgot-step1">
        <h2 id="forgot-title" class="mb-2 text-lg font-bold text-gray-900">Recuperar contraseña</h2>
        <p class="mb-5 text-sm text-gray-500">Introduce tu email y te enviaremos un código de verificación.</p>
        <div id="forgot-error" class="mb-3 hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div>
        <input id="forgot-email" type="email" placeholder="tu@alumnos.unican.es" class="input-field mb-4 w-full" />
        <div class="flex gap-3">
          <button id="forgot-cancel" type="button" class="btn-secondary flex-1">Cancelar</button>
          <button id="forgot-send-otp" type="button" class="btn-primary flex-1">Enviar código</button>
        </div>
      </div>
      <!-- Step 2: introducir OTP + nueva contraseña -->
      <div id="forgot-step2" class="hidden">
        <h2 class="mb-2 text-lg font-bold text-gray-900">Introduce el código</h2>
        <p class="mb-5 text-sm text-gray-500">Revisa tu email. El código caduca en 15 minutos.</p>
        <div id="reset-error" class="mb-3 hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div>
        <div class="space-y-3">
          <input id="reset-otp" type="text" inputmode="numeric" maxlength="6" placeholder="Código de 6 dígitos" class="input-field w-full tracking-widest text-center text-lg" />
          <input id="reset-password" type="password" placeholder="Nueva contraseña (mín. 8 chars)" class="input-field w-full" />
          <input id="reset-password2" type="password" placeholder="Repite la contraseña" class="input-field w-full" />
        </div>
        <div class="mt-4 flex gap-3">
          <button id="reset-back" type="button" class="btn-secondary flex-1">Atrás</button>
          <button id="reset-submit" type="button" class="btn-primary flex-1">Cambiar contraseña</button>
        </div>
      </div>
      <!-- Step 3: éxito -->
      <div id="forgot-step3" class="hidden text-center">
        <div class="mb-4 flex justify-center">
          <div class="flex h-14 w-14 items-center justify-center rounded-full bg-green-100">
            <svg class="h-7 w-7 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>
        </div>
        <h2 class="mb-2 text-lg font-bold text-gray-900">Contraseña actualizada</h2>
        <p class="mb-6 text-sm text-gray-500">Ya puedes iniciar sesión con tu nueva contraseña.</p>
        <button id="reset-done" type="button" class="btn-primary w-full">Iniciar sesión</button>
      </div>
    </div>
  </div>
</AuthLayout>

<script>
  import { api, ApiError, refreshSession } from '../lib/api';

  const form = document.getElementById('login-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const errorBanner = document.getElementById('error-banner')!;
  const blockedModal = document.getElementById('blocked-modal')!;
  const blockedReason = document.getElementById('blocked-reason')!;
  const blockedUntil = document.getElementById('blocked-until')!;
  const blockedClose = document.getElementById('blocked-close')!;
  const togglePwd = document.getElementById('toggle-password')!;
  const rememberInput = document.getElementById('remember-me') as HTMLInputElement;
  const nextUrl = form.dataset.next || '/dashboard';

  // "Recordar inicio de sesión": si la cookie de refresco sigue viva, se renueva
  // la sesión sin pedir credenciales y se vuelve a la página de origen.
  refreshSession().then((ok) => { if (ok) window.location.replace(nextUrl); });
  const passwordInput = document.getElementById('password') as HTMLInputElement;

  // Toggle visibilidad contraseña
  togglePwd.addEventListener('click', () => {
    const isText = passwordInput.type === 'text';
    passwordInput.type = isText ? 'password' : 'text';
  });

  // Mostrar error en campo
  function showFieldError(id: string, msg: string) {
    const el = document.getElementById(id)!;
    el.textContent = msg;
    el.classList.remove('hidden');
  }
  function clearErrors() {
    ['email-error', 'password-error'].forEach((id) => {
      const el = document.getElementById(id)!;
      el.textContent = '';
      el.classList.add('hidden');
    });
    errorBanner.classList.add('hidden');
    errorBanner.textContent = '';
  }

  function showBlockedModal(detail: { reason: string; permanent: boolean; blockedUntil: string | null }) {
    blockedReason.textContent = `Motivo: ${detail.reason}`;
    if (detail.permanent) {
      blockedUntil.textContent = 'El bloqueo es permanente.';
    } else if (detail.blockedUntil) {
      const date = new Date(detail.blockedUntil).toLocaleString('es-ES');
      blockedUntil.textContent = `Podrás acceder de nuevo el: ${date}`;
    }
    blockedModal.classList.remove('hidden');
    blockedModal.classList.add('flex');
  }

  blockedClose.addEventListener('click', () => {
    blockedModal.classList.add('hidden');
    blockedModal.classList.remove('flex');
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearErrors();

    const email = (document.getElementById('email') as HTMLInputElement).value.trim();
    const password = (document.getElementById('password') as HTMLInputElement).value;

    // Validación cliente básica
    let hasError = false;
    if (!email) { showFieldError('email-error', 'El email es obligatorio'); hasError = true; }
    if (!password) { showFieldError('password-error', 'La contraseña es obligatoria'); hasError = true; }
    if (hasError) return;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Iniciando sesión…';

    try {
      const res = await api.post<{ mfaRequired?: boolean }>('/auth/login', { email, password, rememberMe: rememberInput.checked });
      if (res?.mfaRequired) {
        showMfaStep();
        return;
      }
      window.location.href = nextUrl;
    } catch (err) {
      if (err instanceof ApiError) {
        if (err.status === 403) {
          // Usuario bloqueado
          const data = err.data as { detail?: { reason: string; permanent: boolean; blockedUntil: string | null } };
          if (data?.detail) {
            showBlockedModal(data.detail);
          } else {
            errorBanner.textContent = 'Tu cuenta está bloqueada.';
            errorBanner.classList.remove('hidden');
          }
        } else {
          errorBanner.textContent = err.message || 'Credenciales incorrectas.';
          errorBanner.classList.remove('hidden');
        }
      }
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Iniciar sesión';
    }
  });

  // ── Segundo factor (MFA) ─────────────────────────────────
  const mfaForm      = document.getElementById('mfa-form') as HTMLFormElement;
  const mfaCode      = document.getElementById('mfa-code') as HTMLInputElement;
  const mfaError     = document.getElementById('mfa-error')!;
  const mfaSubmit    = document.getElementById('mfa-submit') as HTMLButtonElement;
  const mfaToggle    = document.getElementById('mfa-toggle')!;
  const mfaBack      = document.getElementById('mfa-back')!;
  const mfaLabel     = document.getElementById('mfa-code-label')!;
  const hintApp      = document.getElementById('mfa-hint-app')!;
  const hintRecovery = document.getElementById('mfa-hint-recovery')!;
  const registerLink = document.getElementById('register-link')!;
  let useRecovery = false;

  function setMfaMode(recovery: boolean) {
    useRecovery = recovery;
    hintApp.classList.toggle('hidden', recovery);
    hintRecovery.classList.toggle('hidden', !recovery);
    mfaLabel.textContent = recovery ? 'Código de recuperación' : 'Código de verificación';
    mfaToggle.textContent = recovery ? 'Usar el código de la app' : 'Usar un código de recuperación';
    mfaCode.inputMode = recovery ? 'text' : 'numeric';
    mfaCode.maxLength = recovery ? 11 : 7;
    mfaCode.placeholder = recovery ? 'XXXXX-XXXXX' : '123456';
    mfaCode.value = '';
    mfaError.classList.add('hidden');
    mfaCode.focus();
  }

  function showMfaStep() {
    form.classList.add('hidden');
    registerLink.classList.add('hidden');
    mfaForm.classList.remove('hidden');
    setMfaMode(false);
  }

  function backToLogin() {
    mfaForm.classList.add('hidden');
    form.classList.remove('hidden');
    registerLink.classList.remove('hidden');
    passwordInput.value = '';
    passwordInput.focus();
  }

  mfaToggle.addEventListener('click', () => setMfaMode(!useRecovery));
  mfaBack.addEventListener('click', backToLogin);

  mfaForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    mfaError.classList.add('hidden');
    const value = mfaCode.value.trim();
    if (!useRecovery && !/^\d{3}\s?\d{3}$/.test(value)) {
      mfaError.textContent = 'El código debe tener 6 dígitos.';
      mfaError.classList.remove('hidden');
      return;
    }
    if (useRecovery && !/^[0-9A-Za-z]{5}-?[0-9A-Za-z]{5}$/.test(value)) {
      mfaError.textContent = 'El código de recuperación tiene el formato XXXXX-XXXXX.';
      mfaError.classList.remove('hidden');
      return;
    }

    mfaSubmit.disabled = true;
    mfaSubmit.textContent = 'Verificando…';
    try {
      await api.post('/auth/mfa/challenge', useRecovery ? { recoveryCode: value } : { code: value.replace(/\s+/g, '') });
      window.location.href = nextUrl;
    } catch (err) {
      if (err instanceof ApiError) {
        const data = err.data as { code?: string; details?: { remainingAttempts?: number; retryAfter?: number } } | undefined;
        if (data?.code === 'MFA_CHALLENGE_EXPIRED') {
          backToLogin();
          errorBanner.textContent = 'La verificación ha caducado. Vuelve a iniciar sesión.';
          errorBanner.classList.remove('hidden');
          return;
        }
        if (err.status === 403) {
          const d = err.data as { detail?: { reason: string; permanent: boolean; blockedUntil: string | null } };
          backToLogin();
          if (d?.detail) showBlockedModal(d.detail);
          return;
        }
        let msg = err.message || 'Código incorrecto.';
        const remaining = data?.details?.remainingAttempts;
        if (data?.code === 'MFA_INVALID_CODE' && typeof remaining === 'number') {
          msg = remaining > 0 ? `Código incorrecto. Te quedan ${remaining} intento(s).` : 'Código incorrecto. No quedan intentos.';
        }
        if (data?.code === 'MFA_LOCKED' && data.details?.retryAfter) {
          msg = `${err.message} Inténtalo de nuevo en ${Math.ceil(data.details.retryAfter / 60)} min.`;
        }
        mfaError.textContent = msg;
        mfaError.classList.remove('hidden');
      }
    } finally {
      mfaSubmit.disabled = false;
      mfaSubmit.textContent = 'Verificar';
    }
  });

  // ── Modal recuperación de contraseña ─────────────────────
  const forgotModal   = document.getElementById('forgot-modal')!;
  const forgotLink    = document.getElementById('forgot-password-link')!;
  const forgotCancel  = document.getElementById('forgot-cancel')!;
  const forgotStep1   = document.getElementById('forgot-step1')!;
  const forgotStep2   = document.getElementById('forgot-step2')!;
  const forgotStep3   = document.getElementById('forgot-step3')!;
  const forgotError   = document.getElementById('forgot-error')!;
  const resetError    = document.getElementById('reset-error')!;
  const forgotSendOtp = document.getElementById('forgot-send-otp') as HTMLButtonElement;
  const resetSubmit   = document.getElementById('reset-submit') as HTMLButtonElement;
  const resetBack     = document.getElementById('reset-back')!;
  const resetDone     = document.getElementById('reset-done')!;
  const forgotEmailEl = document.getElementById('forgot-email') as HTMLInputElement;

  function openForgot() {
    forgotStep1.classList.remove('hidden');
    forgotStep2.classList.add('hidden');
    forgotStep3.classList.add('hidden');
    forgotError.classList.add('hidden');
    forgotEmailEl.value = '';
    forgotModal.classList.remove('hidden');
    forgotModal.classList.add('flex');
  }
  function closeForgot() {
    forgotModal.classList.add('hidden');
    forgotModal.classList.remove('flex');
  }

  forgotLink.addEventListener('click', openForgot);
  forgotCancel.addEventListener('click', closeForgot);
  resetDone.addEventListener('click', closeForgot);

  forgotSendOtp.addEventListener('click', async () => {
    const email = forgotEmailEl.value.trim();
    if (!email) { forgotError.textContent = 'Introduce tu email.'; forgotError.classList.remove('hidden'); return; }
    forgotError.classList.add('hidden');
    forgotSendOtp.disabled = true;
    try {
      await api.post('/auth/forgot-password', { email });
      forgotStep1.classList.add('hidden');
      forgotStep2.classList.remove('hidden');
    } catch (err) {
      forgotError.textContent = err instanceof ApiError ? err.message : 'Error al enviar el código.';
      forgotError.classList.remove('hidden');
    } finally {
      forgotSendOtp.disabled = false;
    }
  });

  resetBack.addEventListener('click', () => {
    forgotStep2.classList.add('hidden');
    forgotStep1.classList.remove('hidden');
  });

  resetSubmit.addEventListener('click', async () => {
    const otpCode     = (document.getElementById('reset-otp') as HTMLInputElement).value.trim();
    const newPassword = (document.getElementById('reset-password') as HTMLInputElement).value;
    const confirm     = (document.getElementById('reset-password2') as HTMLInputElement).value;
    resetError.classList.add('hidden');

    if (otpCode.length !== 6) { resetError.textContent = 'El código debe tener 6 dígitos.'; resetError.classList.remove('hidden'); return; }
    if (!newPassword) { resetError.textContent = 'Introduce la nueva contraseña.'; resetError.classList.remove('hidden'); return; }
    if (newPassword !== confirm) { resetError.textContent = 'Las contraseñas no coinciden.'; resetError.classList.remove('hidden'); return; }

    resetSubmit.disabled = true;
    try {
      await api.post('/auth/reset-password', { email: forgotEmailEl.value.trim(), otpCode, newPassword });
      forgotStep2.classList.add('hidden');
      forgotStep3.classList.remove('hidden');
    } catch (err) {
      resetError.textContent = err instanceof ApiError ? err.message : 'Error al cambiar la contraseña.';
      resetError.classList.remove('hidden');
    } finally {
      resetSubmit.disabled = false;
    }
  });
</script>
