---
import MainLayout from '../layouts/MainLayout.astro';
import { serverApi, type UserMe, type Carrera, type Curso } from '../lib/api';
const api = serverApi(Astro.request);

interface UserDetail extends UserMe {
  name: string;
  carreraId: string | null;
  cursoId: string | null;
}

let user: UserDetail | null = null;
try {
  user = await api.get<UserDetail>('/auth/me');
} catch {
  return Astro.redirect('/login');
}

let carreras: Carrera[] = [];
let cursos: Curso[] = [];
try {
  carreras = await api.get<Carrera[]>('/public/careers');
  if (user.carreraId) {
    cursos = await api.get<Curso[]>(`/public/careers/${user.carreraId}/courses`);
  }
} catch { /* no bloquear la página si falla */ }

interface AsignaturaExpediente {
  id: string;
  nombre: string;
  codigo: string;
  curso: { id: string; nombre: string; carrera: { nombre: string } };
}
interface MfaStatus {
  enabled: boolean;
  enabledAt: string | null;
  recoveryCodesRemaining: number;
  degraded?: boolean;
}
let mfa: MfaStatus | null = null;
try {
  mfa = await api.get<MfaStatus>('/auth/mfa');
} catch { /* mfa-service caído: se muestra como no disponible */ }
const mfaAvailable = mfa !== null && !mfa.degraded;
const mfaEnabledAt = mfa?.enabledAt
  ? new Date(mfa.enabledAt).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;

let expediente: AsignaturaExpediente[] = [];
try {
  expediente = await api.get<AsignaturaExpediente[]>('/me/expediente');
} catch { /* continuar sin expediente */ }
---

<MainLayout title="Ajustes">
  <div class="mx-auto max-w-xl">
    <h1 class="mb-6 text-2xl font-bold text-gray-900">Ajustes de cuenta</h1>

    <div id="success-banner" role="status" aria-live="polite"
         class="mb-4 hidden rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-700">
      Cambios guardados correctamente.
    </div>
    <div id="error-banner" role="alert" aria-live="polite"
         class="mb-4 hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div>

    <form id="settings-form" novalidate class="space-y-6 rounded-2xl border border-gray-200 bg-white p-8 shadow-sm">
      <div>
        <label for="name" class="mb-1.5 block text-sm font-medium text-gray-700">Nombre</label>
        <input id="name" name="name" type="text" required
               value={user.name} class="input-field" />
        <p id="name-error" class="mt-1 hidden text-xs text-red-600"></p>
      </div>

      <div>
        <label for="carrera" class="mb-1.5 block text-sm font-medium text-gray-700">Carrera</label>
        <select id="carrera" name="carreraId" class="input-field">
          <option value="">Sin carrera seleccionada</option>
          {carreras.map((c) => (
            <option value={c.id} selected={c.id === user!.carreraId}>{c.nombre}</option>
          ))}
        </select>
      </div>

      <div>
        <label for="curso" class="mb-1.5 block text-sm font-medium text-gray-700">Curso</label>
        <select id="curso" name="cursoId" class="input-field">
          <option value="">Sin curso seleccionado</option>
          {cursos.map((c) => (
            <option value={c.id} selected={c.id === user!.cursoId}>{c.nombre}</option>
          ))}
        </select>
      </div>

      <button type="submit" id="submit-btn" class="btn-primary w-full">
        Guardar cambios
      </button>
    </form>

    <!-- ── Módulo Expediente ──────────────────────────────── -->
    <h2 class="mb-4 mt-10 text-lg font-semibold text-gray-900">Expediente académico</h2>
    <p class="mb-4 text-sm text-gray-500">
      Añade las asignaturas en las que estás matriculado. Se usarán para buscar y publicar intercambios de grupo.
    </p>

    <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm space-y-5">
      <!-- Buscador -->
      <div>
        <label for="subject-search" class="mb-1.5 block text-sm font-medium text-gray-700">
          Buscar asignatura
        </label>
        <div class="flex gap-2">
          <input id="subject-search" type="text" placeholder="Nombre o código…" class="input-field flex-1" autocomplete="off" />
          <button id="subject-search-btn" type="button" class="btn-secondary whitespace-nowrap">Buscar</button>
        </div>
        <ul id="subject-results" class="mt-2 hidden divide-y divide-gray-100 rounded-xl border border-gray-200 bg-white shadow-sm"></ul>
      </div>

      <!-- Lista del expediente -->
      <div>
        <h3 class="mb-3 text-sm font-medium text-gray-700">Mis asignaturas</h3>
        <ul id="expediente-list" class="divide-y divide-gray-100 rounded-xl border border-gray-200">
          {expediente.length === 0 ? (
            <li id="expediente-empty" class="px-4 py-6 text-center text-sm text-gray-400">
              No tienes asignaturas añadidas todavía.
            </li>
          ) : (
            expediente.map((a) => (
              <li class="expediente-item flex items-center justify-between px-4 py-3" data-id={a.id}>
                <div>
                  <p class="text-sm font-medium text-gray-800">{a.codigo} — {a.nombre}</p>
                  <p class="text-xs text-gray-400">{a.curso.carrera.nombre} · {a.curso.nombre}</p>
                </div>
                <button
                  type="button"
                  class="remove-subject-btn text-xs font-medium text-red-500 hover:text-red-700 hover:underline"
                  data-id={a.id}
                >
                  Eliminar
                </button>
              </li>
            ))
          )}
        </ul>
      </div>
    </div>

    <!-- ── Verificación en dos pasos (MFA) ─────────────────── -->
    <h2 class="mb-4 mt-10 text-lg font-semibold text-gray-900">Verificación en dos pasos</h2>

    <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-sm text-gray-600">
            Además de tu contraseña, se te pedirá un código de 6 dígitos de una app de autenticación
            (Microsoft Authenticator, Google Authenticator, Authy…).
          </p>
          {mfa?.enabled ? (
            <p class="mt-3 text-sm">
              <span class="inline-flex items-center gap-1 rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-semibold text-green-700">● Activada</span>
              {mfaEnabledAt && <span class="ml-2 text-gray-500">desde el {mfaEnabledAt}</span>}
            </p>
          ) : mfaAvailable ? (
            <p class="mt-3">
              <span class="inline-flex items-center gap-1 rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-semibold text-gray-600">○ Desactivada</span>
            </p>
          ) : (
            <p class="mt-3 text-sm text-amber-700">El servicio de verificación en dos pasos no está disponible en este momento.</p>
          )}
          {mfa?.enabled && (
            <p class="mt-2 text-xs text-gray-500">
              Códigos de recuperación disponibles: <strong>{mfa.recoveryCodesRemaining}</strong>
              {mfa.recoveryCodesRemaining <= 2 && <span class="text-amber-700"> · te recomendamos regenerarlos</span>}
            </p>
          )}
        </div>
      </div>

      <div class="mt-5 flex flex-wrap gap-3">
        {mfa?.enabled ? (
          <>
            <button type="button" id="mfa-regen-btn" class="btn-secondary">Regenerar códigos de recuperación</button>
            <button type="button" id="mfa-disable-btn" class="btn-secondary !text-red-600">Desactivar</button>
          </>
        ) : (
          <button type="button" id="mfa-enable-btn" class="btn-primary" disabled={!mfaAvailable}>Activar verificación en dos pasos</button>
        )}
      </div>
    </div>

    <!-- Modal de MFA (asistente de activación / desactivación / regeneración) -->
    <div id="mfa-modal" role="dialog" aria-modal="true" aria-labelledby="mfa-modal-title"
         class="fixed inset-0 z-50 hidden items-center justify-center overflow-y-auto bg-black/50 p-4">
      <div class="my-8 w-full max-w-md rounded-2xl bg-white p-6 shadow-xl sm:p-8">
        <h2 id="mfa-modal-title" class="mb-1 text-lg font-bold text-gray-900"></h2>
        <p id="mfa-step-label" class="mb-5 text-xs font-medium uppercase tracking-wide text-gray-400"></p>
        <div id="mfa-modal-error" role="alert" class="mb-4 hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div>

        <!-- Paso: contraseña -->
        <form id="mfa-step-password" class="mfa-step hidden space-y-4" novalidate>
          <p class="text-sm text-gray-600">Por seguridad, confirma tu contraseña para continuar.</p>
          <input id="mfa-password" type="password" autocomplete="current-password" placeholder="Contraseña" class="input-field" />
          <div class="flex gap-3">
            <button type="button" class="mfa-close btn-secondary flex-1">Cancelar</button>
            <button type="submit" class="btn-primary flex-1">Continuar</button>
          </div>
        </form>

        <!-- Paso: QR + código -->
        <form id="mfa-step-qr" class="mfa-step hidden space-y-4" novalidate>
          <ol class="list-decimal space-y-1 pl-5 text-sm text-gray-600">
            <li>Abre <strong>Microsoft Authenticator</strong> (u otra app de autenticación).</li>
            <li>Pulsa <strong>+</strong> → <strong>Otra cuenta</strong> y escanea este código QR.</li>
            <li>Introduce el código de 6 dígitos que aparece en la app.</li>
          </ol>
          <div class="flex justify-center">
            <canvas id="mfa-qr" class="rounded-lg border border-gray-200" width="220" height="220" aria-label="Código QR para la app de autenticación"></canvas>
          </div>
          <details class="rounded-lg bg-gray-50 px-4 py-3 text-sm text-gray-600">
            <summary class="cursor-pointer font-medium text-gray-700">¿No puedes escanear el código?</summary>
            <p class="mt-2">Añade la cuenta manualmente con estos datos (tipo <strong>basada en tiempo</strong>):</p>
            <dl class="mt-2 grid grid-cols-[auto,1fr] gap-x-3 gap-y-1 text-xs">
              <dt class="text-gray-500">Cuenta</dt><dd id="mfa-manual-account" class="font-mono"></dd>
              <dt class="text-gray-500">Clave</dt><dd id="mfa-manual-secret" class="break-all font-mono font-semibold text-gray-900"></dd>
            </dl>
          </details>
          <div>
            <label for="mfa-confirm-code" class="mb-1.5 block text-sm font-medium text-gray-700">Código de la app</label>
            <input id="mfa-confirm-code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="7"
                   placeholder="123456" class="input-field text-center text-lg tracking-widest" />
          </div>
          <div class="flex gap-3">
            <button type="button" id="mfa-qr-cancel" class="btn-secondary flex-1">Cancelar</button>
            <button type="submit" class="btn-primary flex-1">Activar</button>
          </div>
        </form>

        <!-- Paso: códigos de recuperación -->
        <div id="mfa-step-codes" class="mfa-step hidden space-y-4">
          <p class="text-sm text-gray-600">
            Guarda estos códigos en un lugar seguro. Si pierdes el móvil, podrás entrar con uno de ellos.
            <strong>Cada código sirve una sola vez y no se volverán a mostrar.</strong>
          </p>
          <ul id="mfa-codes" class="grid grid-cols-2 gap-2 rounded-lg bg-gray-50 p-4 font-mono text-sm text-gray-900"></ul>
          <div class="flex gap-3">
            <button type="button" id="mfa-codes-copy" class="btn-secondary flex-1">Copiar</button>
            <button type="button" id="mfa-codes-download" class="btn-secondary flex-1">Descargar .txt</button>
          </div>
          <label class="flex items-center gap-2 text-sm text-gray-700">
            <input id="mfa-codes-saved" type="checkbox" class="h-4 w-4 rounded border-gray-300" />
            He guardado mis códigos de recuperación
          </label>
          <button type="button" id="mfa-codes-done" class="btn-primary w-full" disabled>Terminar</button>
        </div>

        <!-- Paso: verificar con código (desactivar / regenerar) -->
        <form id="mfa-step-verify" class="mfa-step hidden space-y-4" novalidate>
          <p id="mfa-verify-text" class="text-sm text-gray-600"></p>
          <input id="mfa-verify-password" type="password" autocomplete="current-password" placeholder="Contraseña" class="input-field" />
          <input id="mfa-verify-code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="11"
                 placeholder="Código de la app (6 dígitos)" class="input-field text-center tracking-widest" />
          <div class="flex gap-3">
            <button type="button" class="mfa-close btn-secondary flex-1">Cancelar</button>
            <button type="submit" id="mfa-verify-submit" class="btn-primary flex-1">Confirmar</button>
          </div>
        </form>
      </div>
    </div>

    <!-- ── Cambio de contraseña ────────────────────────────── -->
    <h2 class="mb-4 mt-10 text-lg font-semibold text-gray-900">Cambiar contraseña</h2>

    <div id="pw-success-banner" role="status" aria-live="polite"
         class="mb-4 hidden rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-700">
      Contraseña actualizada correctamente.
    </div>
    <div id="pw-error-banner" role="alert" aria-live="polite"
         class="mb-4 hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div>

    <form id="pw-form" novalidate class="space-y-5 rounded-2xl border border-gray-200 bg-white p-8 shadow-sm">
      <div>
        <label for="current-password" class="mb-1.5 block text-sm font-medium text-gray-700">
          Contraseña actual
        </label>
        <input id="current-password" name="currentPassword" type="password" required
               autocomplete="current-password" class="input-field" />
      </div>

      <div>
        <label for="new-password" class="mb-1.5 block text-sm font-medium text-gray-700">
          Nueva contraseña
        </label>
        <input id="new-password" name="newPassword" type="password" required
               autocomplete="new-password" class="input-field" />
        <p class="mt-1 text-xs text-gray-500">
          Mínimo 8 caracteres, mayúscula, minúscula, número y símbolo.
        </p>
      </div>

      <div>
        <label for="confirm-password" class="mb-1.5 block text-sm font-medium text-gray-700">
          Confirmar nueva contraseña
        </label>
        <input id="confirm-password" name="confirmPassword" type="password" required
               autocomplete="new-password" class="input-field" />
        <p id="pw-match-error" class="mt-1 hidden text-xs text-red-600">
          Las contraseñas no coinciden.
        </p>
      </div>

      <button type="submit" id="pw-submit-btn" class="btn-primary w-full">
        Cambiar contraseña
      </button>
    </form>
  </div>
</MainLayout>

<script>
  import { api, ApiError, type Curso } from '../lib/api';

  const form        = document.getElementById('settings-form') as HTMLFormElement;
  const submitBtn   = document.getElementById('submit-btn') as HTMLButtonElement;
  const successBanner = document.getElementById('success-banner')!;
  const errorBanner   = document.getElementById('error-banner')!;
  const carreraSelect = document.getElementById('carrera') as HTMLSelectElement;
  const cursoSelect   = document.getElementById('curso') as HTMLSelectElement;

  // Recargar cursos al cambiar carrera (usa endpoint público, sin auth de admin)
  carreraSelect.addEventListener('change', async () => {
    const id = carreraSelect.value;
    cursoSelect.innerHTML = '<option value="">Cargando…</option>';
    cursoSelect.disabled = true;
    if (!id) {
      cursoSelect.innerHTML = '<option value="">Sin curso seleccionado</option>';
      return;
    }
    try {
      const cursos = await api.get<Curso[]>(`/public/careers/${id}/courses`);
      cursoSelect.innerHTML =
        '<option value="">Selecciona tu curso…</option>' +
        cursos.map((c) => `<option value="${c.id}">${c.nombre}</option>`).join('');
      cursoSelect.disabled = false;
    } catch {
      cursoSelect.innerHTML = '<option value="">Error al cargar</option>';
    }
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    successBanner.classList.add('hidden');
    errorBanner.classList.add('hidden');

    const name      = (document.getElementById('name') as HTMLInputElement).value.trim();
    const carreraId = carreraSelect.value || null;
    const cursoId   = cursoSelect.value || null;

    if (!name) {
      document.getElementById('name-error')!.textContent = 'El nombre no puede estar vacío';
      document.getElementById('name-error')!.classList.remove('hidden');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Guardando…';

    try {
      await api.patch('/auth/me', { name, carreraId, cursoId });
      successBanner.classList.remove('hidden');
    } catch (err) {
      errorBanner.textContent = err instanceof ApiError ? err.message : 'Error al guardar';
      errorBanner.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Guardar cambios';
    }
  });

  // ── Formulario de cambio de contraseña ────────────────────
  const pwForm          = document.getElementById('pw-form') as HTMLFormElement;
  const pwSubmitBtn     = document.getElementById('pw-submit-btn') as HTMLButtonElement;
  const pwSuccessBanner = document.getElementById('pw-success-banner')!;
  const pwErrorBanner   = document.getElementById('pw-error-banner')!;
  const pwMatchError    = document.getElementById('pw-match-error')!;

  pwForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    pwSuccessBanner.classList.add('hidden');
    pwErrorBanner.classList.add('hidden');
    pwMatchError.classList.add('hidden');

    const currentPassword = (document.getElementById('current-password') as HTMLInputElement).value;
    const newPassword     = (document.getElementById('new-password') as HTMLInputElement).value;
    const confirmPassword = (document.getElementById('confirm-password') as HTMLInputElement).value;

    if (newPassword !== confirmPassword) {
      pwMatchError.classList.remove('hidden');
      return;
    }

    pwSubmitBtn.disabled = true;
    pwSubmitBtn.textContent = 'Guardando…';

    try {
      await api.patch('/auth/settings/password', { currentPassword, newPassword });
      pwSuccessBanner.classList.remove('hidden');
      pwForm.reset();
    } catch (err) {
      pwErrorBanner.textContent = err instanceof ApiError ? err.message : 'Error al cambiar la contraseña';
      pwErrorBanner.classList.remove('hidden');
    } finally {
      pwSubmitBtn.disabled = false;
      pwSubmitBtn.textContent = 'Cambiar contraseña';
    }
  });

  // ── Verificación en dos pasos (MFA) ───────────────────────
  const mfaModal      = document.getElementById('mfa-modal')!;
  const mfaTitle      = document.getElementById('mfa-modal-title')!;
  const mfaStepLabel  = document.getElementById('mfa-step-label')!;
  const mfaModalError = document.getElementById('mfa-modal-error')!;
  const stepPassword  = document.getElementById('mfa-step-password') as HTMLFormElement;
  const stepQr        = document.getElementById('mfa-step-qr') as HTMLFormElement;
  const stepCodes     = document.getElementById('mfa-step-codes')!;
  const stepVerify    = document.getElementById('mfa-step-verify') as HTMLFormElement;
  const codesList     = document.getElementById('mfa-codes')!;
  const codesSaved    = document.getElementById('mfa-codes-saved') as HTMLInputElement;
  const codesDone     = document.getElementById('mfa-codes-done') as HTMLButtonElement;
  let enrollmentId: string | null = null;
  let recoveryCodes: string[] = [];
  let verifyMode: 'disable' | 'regen' = 'disable';

  function mfaError(msg: string | null) {
    mfaModalError.textContent = msg ?? '';
    mfaModalError.classList.toggle('hidden', !msg);
  }

  /** Mensaje legible para los errores del API de MFA. */
  function mfaMessage(err: unknown): string {
    if (!(err instanceof ApiError)) return 'Error de conexión. Inténtalo de nuevo.';
    const data = err.data as { code?: string; details?: { remainingAttempts?: number; retryAfter?: number } } | undefined;
    const remaining = data?.details?.remainingAttempts;
    if (data?.code === 'MFA_INVALID_CODE' && typeof remaining === 'number') {
      return remaining > 0 ? `Código incorrecto. Te quedan ${remaining} intento(s).` : 'Código incorrecto. No quedan intentos.';
    }
    if (data?.code === 'MFA_LOCKED' && data.details?.retryAfter) {
      return `${err.message} Inténtalo de nuevo en ${Math.ceil(data.details.retryAfter / 60)} min.`;
    }
    return err.message;
  }

  function showStep(step: HTMLElement, title: string, label: string) {
    document.querySelectorAll('.mfa-step').forEach((el) => el.classList.add('hidden'));
    step.classList.remove('hidden');
    mfaTitle.textContent = title;
    mfaStepLabel.textContent = label;
    mfaError(null);
    (step.querySelector('input') as HTMLInputElement | null)?.focus();
  }

  function openMfaModal() {
    mfaModal.classList.remove('hidden');
    mfaModal.classList.add('flex');
  }

  function closeMfaModal() {
    mfaModal.classList.add('hidden');
    mfaModal.classList.remove('flex');
    mfaModal.querySelectorAll('input').forEach((i) => { if (i.type !== 'checkbox') i.value = ''; else i.checked = false; });
  }

  function setBusy(form: HTMLFormElement, busy: boolean) {
    form.querySelectorAll('button').forEach((b) => { (b as HTMLButtonElement).disabled = busy; });
  }

  async function cancelEnrollment() {
    if (enrollmentId) {
      const id = enrollmentId;
      enrollmentId = null;
      await api.delete(`/auth/mfa/enrollments/${encodeURIComponent(id)}`).catch(() => undefined);
    }
  }

  document.querySelectorAll('.mfa-close').forEach((b) => b.addEventListener('click', closeMfaModal));
  document.getElementById('mfa-qr-cancel')!.addEventListener('click', async () => {
    await cancelEnrollment();
    closeMfaModal();
  });

  // Paso 1: contraseña
  document.getElementById('mfa-enable-btn')?.addEventListener('click', () => {
    openMfaModal();
    showStep(stepPassword, 'Activar verificación en dos pasos', 'Paso 1 de 3 · Confirma tu identidad');
  });

  stepPassword.addEventListener('submit', async (e) => {
    e.preventDefault();
    const password = (document.getElementById('mfa-password') as HTMLInputElement).value;
    if (!password) return mfaError('Introduce tu contraseña.');
    setBusy(stepPassword, true);
    try {
      await api.post('/auth/reauthenticate', { password });
      const enr = await api.post<{
        enrollmentId: string;
        provisioningUri: string;
        manualEntry: { account: string; secret: string };
      }>('/auth/mfa/enrollments');
      enrollmentId = enr.enrollmentId;

      // Paso 2: QR generado en el navegador (el secreto no sale a ningún servicio externo)
      const QRCode = (await import('qrcode')).default;
      await QRCode.toCanvas(document.getElementById('mfa-qr') as HTMLCanvasElement, enr.provisioningUri, { width: 220, margin: 1 });
      document.getElementById('mfa-manual-account')!.textContent = enr.manualEntry.account;
      document.getElementById('mfa-manual-secret')!.textContent = enr.manualEntry.secret;
      showStep(stepQr, 'Activar verificación en dos pasos', 'Paso 2 de 3 · Escanea el código QR');
    } catch (err) {
      mfaError(mfaMessage(err));
    } finally {
      setBusy(stepPassword, false);
    }
  });

  // Paso 2: confirmar con el primer código
  stepQr.addEventListener('submit', async (e) => {
    e.preventDefault();
    const code = (document.getElementById('mfa-confirm-code') as HTMLInputElement).value.replace(/\s+/g, '');
    if (!/^\d{6}$/.test(code)) return mfaError('El código debe tener 6 dígitos.');
    if (!enrollmentId) return mfaError('El proceso ha caducado. Vuelve a empezar.');
    setBusy(stepQr, true);
    try {
      const r = await api.post<{ recoveryCodes: string[] }>(`/auth/mfa/enrollments/${encodeURIComponent(enrollmentId)}/confirm`, { code });
      enrollmentId = null;
      showCodes(r.recoveryCodes, 'Verificación en dos pasos activada', 'Paso 3 de 3 · Códigos de recuperación');
    } catch (err) {
      const code = err instanceof ApiError ? (err.data as { code?: string } | undefined)?.code : undefined;
      if (code === 'ENROLLMENT_EXPIRED' || code === 'NOT_FOUND') {
        enrollmentId = null;
        showStep(stepPassword, 'Activar verificación en dos pasos', 'Paso 1 de 3 · Confirma tu identidad');
        mfaError('El código QR ha caducado (10 minutos). Vuelve a empezar.');
      } else {
        mfaError(mfaMessage(err));
      }
    } finally {
      setBusy(stepQr, false);
    }
  });

  // Paso 3: códigos de recuperación
  function showCodes(codes: string[], title: string, label: string) {
    recoveryCodes = codes;
    codesList.replaceChildren(...codes.map((c) => {
      const li = document.createElement('li');
      li.textContent = c;
      return li;
    }));
    codesSaved.checked = false;
    codesDone.disabled = true;
    showStep(stepCodes, title, label);
  }

  codesSaved.addEventListener('change', () => { codesDone.disabled = !codesSaved.checked; });
  codesDone.addEventListener('click', () => window.location.reload());

  document.getElementById('mfa-codes-copy')!.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText(recoveryCodes.join('\n'));
      btn.textContent = 'Copiados ✓';
    } catch {
      btn.textContent = 'No se pudo copiar';
    }
    setTimeout(() => { btn.textContent = 'Copiar'; }, 2000);
  });

  document.getElementById('mfa-codes-download')!.addEventListener('click', () => {
    const text = `Códigos de recuperación de xChanger\nGenerados: ${new Date().toLocaleString('es-ES')}\n` +
      'Cada código solo se puede usar una vez.\n\n' + recoveryCodes.join('\n') + '\n';
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([text], { type: 'text/plain' }));
    a.download = 'xchanger-codigos-recuperacion.txt';
    a.click();
    URL.revokeObjectURL(a.href);
  });

  // Desactivar / regenerar: contraseña (solo desactivar) + código de la app
  const verifyPassword = document.getElementById('mfa-verify-password') as HTMLInputElement;
  const verifyCode     = document.getElementById('mfa-verify-code') as HTMLInputElement;

  document.getElementById('mfa-disable-btn')?.addEventListener('click', () => {
    verifyMode = 'disable';
    verifyPassword.classList.remove('hidden');
    verifyCode.placeholder = 'Código de la app o de recuperación';
    document.getElementById('mfa-verify-text')!.textContent =
      'Introduce tu contraseña y un código de tu app de autenticación (o un código de recuperación).';
    openMfaModal();
    showStep(stepVerify, 'Desactivar verificación en dos pasos', 'Confirma tu identidad');
  });

  document.getElementById('mfa-regen-btn')?.addEventListener('click', () => {
    verifyMode = 'regen';
    verifyPassword.classList.add('hidden');
    verifyCode.placeholder = 'Código de la app (6 dígitos)';
    document.getElementById('mfa-verify-text')!.textContent =
      'Introduce un código de tu app de autenticación. Los códigos de recuperación anteriores dejarán de funcionar.';
    openMfaModal();
    showStep(stepVerify, 'Regenerar códigos de recuperación', 'Confirma tu identidad');
  });

  stepVerify.addEventListener('submit', async (e) => {
    e.preventDefault();
    const value = verifyCode.value.trim();
    const isApp = /^\d{3}\s?\d{3}$/.test(value);
    const isRecovery = /^[0-9A-Za-z]{5}-?[0-9A-Za-z]{5}$/.test(value);
    if (verifyMode === 'disable' && !verifyPassword.value) return mfaError('Introduce tu contraseña.');
    if (verifyMode === 'regen' && !isApp) return mfaError('El código debe tener 6 dígitos.');
    if (!isApp && !isRecovery) return mfaError('Introduce un código de 6 dígitos o un código de recuperación (XXXXX-XXXXX).');

    setBusy(stepVerify, true);
    try {
      if (verifyMode === 'disable') {
        await api.post('/auth/mfa/disable', {
          password: verifyPassword.value,
          ...(isApp ? { code: value.replace(/\s+/g, '') } : { recoveryCode: value }),
        });
        closeMfaModal();
        window.location.reload();
      } else {
        const r = await api.post<{ recoveryCodes: string[] }>('/auth/mfa/recovery-codes', { code: value.replace(/\s+/g, '') });
        showCodes(r.recoveryCodes, 'Nuevos códigos de recuperación', 'Los anteriores ya no son válidos');
      }
    } catch (err) {
      mfaError(mfaMessage(err));
    } finally {
      setBusy(stepVerify, false);
    }
  });

  // Si se cierra la pestaña con un alta a medias, se cancela el enrolamiento
  window.addEventListener('pagehide', () => { void cancelEnrollment(); });

  // ── Expediente ────────────────────────────────────────────
  interface SubjectResult {
    id: string;
    nombre: string;
    codigo: string;
    curso: { nombre: string; carrera: { nombre: string } };
  }

  const searchInput  = document.getElementById('subject-search') as HTMLInputElement;
  const searchBtn    = document.getElementById('subject-search-btn')!;
  const resultsList  = document.getElementById('subject-results')!;
  const expedienteList = document.getElementById('expediente-list')!;

  // Conjunto de IDs ya matriculados para evitar duplicados en la UI
  const enrolledIds = new Set<string>(
    Array.from(document.querySelectorAll<HTMLElement>('.expediente-item')).map((el) => el.dataset.id!),
  );

  function renderExpedienteItem(a: SubjectResult) {
    const li = document.createElement('li');
    li.className = 'expediente-item flex items-center justify-between px-4 py-3';
    li.dataset.id = a.id;
    li.innerHTML = `
      <div>
        <p class="text-sm font-medium text-gray-800">${a.codigo} — ${a.nombre}</p>
        <p class="text-xs text-gray-400">${a.curso.carrera.nombre} · ${a.curso.nombre}</p>
      </div>
      <button type="button" class="remove-subject-btn text-xs font-medium text-red-500 hover:text-red-700 hover:underline" data-id="${a.id}">
        Eliminar
      </button>
    `;
    attachRemoveListener(li.querySelector('.remove-subject-btn')!);
    return li;
  }

  function attachRemoveListener(btn: Element) {
    btn.addEventListener('click', async () => {
      const id = (btn as HTMLElement).dataset.id!;
      try {
        await api.delete(`/me/expediente/${id}`);
        document.querySelector(`.expediente-item[data-id="${id}"]`)?.remove();
        enrolledIds.delete(id);
        if (expedienteList.querySelectorAll('.expediente-item').length === 0) {
          const empty = document.createElement('li');
          empty.id = 'expediente-empty';
          empty.className = 'px-4 py-6 text-center text-sm text-gray-400';
          empty.textContent = 'No tienes asignaturas añadidas todavía.';
          expedienteList.appendChild(empty);
        }
      } catch (err) {
        alert(err instanceof ApiError ? err.message : 'Error al eliminar');
      }
    });
  }

  // Activar los botones de eliminar ya presentes en SSR
  document.querySelectorAll('.remove-subject-btn').forEach(attachRemoveListener);

  async function searchSubjects() {
    const q = searchInput.value.trim();
    if (!q) return;
    try {
      const subjects = await api.get<SubjectResult[]>(`/public/subjects/search?q=${encodeURIComponent(q)}`);
      resultsList.innerHTML = '';
      if (subjects.length === 0) {
        resultsList.innerHTML = '<li class="px-4 py-3 text-sm text-gray-400">Sin resultados.</li>';
      } else {
        subjects.forEach((s) => {
          const li = document.createElement('li');
          li.className = 'flex items-center justify-between px-4 py-2.5 hover:bg-gray-50';
          const isEnrolled = enrolledIds.has(s.id);
          li.innerHTML = `
            <div>
              <p class="text-sm font-medium text-gray-800">${s.codigo} — ${s.nombre}</p>
              <p class="text-xs text-gray-400">${s.curso.carrera.nombre} · ${s.curso.nombre}</p>
            </div>
            <button type="button" class="add-subject-btn text-xs font-medium text-brand hover:underline disabled:opacity-40"
              data-id="${s.id}" data-nombre="${s.nombre}" data-codigo="${s.codigo}"
              data-carrera="${s.curso.carrera.nombre}" data-curso="${s.curso.nombre}"
              ${isEnrolled ? 'disabled' : ''}>
              ${isEnrolled ? 'Ya añadida' : 'Añadir'}
            </button>
          `;
          if (!isEnrolled) {
            li.querySelector('.add-subject-btn')!.addEventListener('click', async (e) => {
              const btn = e.currentTarget as HTMLButtonElement;
              btn.disabled = true;
              btn.textContent = 'Añadiendo…';
              try {
                await api.post('/me/expediente', { asignaturaId: s.id });
                enrolledIds.add(s.id);
                btn.textContent = 'Ya añadida';
                // Añadir al listado visual
                document.getElementById('expediente-empty')?.remove();
                expedienteList.appendChild(renderExpedienteItem(s));
              } catch (err) {
                btn.disabled = false;
                btn.textContent = 'Añadir';
                alert(err instanceof ApiError ? err.message : 'Error al añadir');
              }
            });
          }
          resultsList.appendChild(li);
        });
      }
      resultsList.classList.remove('hidden');
    } catch {
      resultsList.innerHTML = '<li class="px-4 py-3 text-sm text-red-500">Error al buscar.</li>';
      resultsList.classList.remove('hidden');
    }
  }

  searchBtn.addEventListener('click', searchSubjects);
  searchInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') searchSubjects(); });
</script>
