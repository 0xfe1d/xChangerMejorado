---
import MainLayout from '../../layouts/MainLayout.astro';
import { serverApi, type UserMe } from '../../lib/api';
const api = serverApi(Astro.request);

interface UserDetail extends UserMe { name: string; }

interface LogEntry {
  id: string;
  timestamp: string;
  action: string;
  payload: unknown;
  user: { id: string; name: string; email: string };
}

interface LogsResponse {
  logs: LogEntry[];
  total: number;
  page: number;
  pageSize: number;
  totalPages: number;
}

let user: UserDetail | null = null;
try {
  user = await api.get<UserDetail>('/auth/me');
} catch {
  return Astro.redirect('/login');
}
if (user.role !== 'EMBAJADOR' && user.role !== 'PROPIETARIO') {
  return Astro.redirect('/dashboard');
}

const url = new URL(Astro.request.url);
const page       = Number(url.searchParams.get('page') ?? 1);
const action     = url.searchParams.get('action') ?? '';
const userFilter = url.searchParams.get('user') ?? '';
const dateFrom   = url.searchParams.get('from') ?? '';
const dateTo     = url.searchParams.get('to') ?? '';

let logsData: LogsResponse = { logs: [], total: 0, page: 1, pageSize: 50, totalPages: 1 };
try {
  const params = new URLSearchParams({ page: String(page), pageSize: '50' });
  if (action)     params.set('actionFilter', action);
  if (userFilter) params.set('userFilter', userFilter);
  if (dateFrom)   params.set('dateFrom', dateFrom);
  if (dateTo)     params.set('dateTo', dateTo);
  logsData = await api.get<LogsResponse>(`/admin/logs?${params}`);
} catch { /* continuar */ }

// Helper para construir href de paginación preservando todos los filtros
function pageHref(p: number) {
  const q = new URLSearchParams();
  q.set('page', String(p));
  if (action)     q.set('action', action);
  if (userFilter) q.set('user', userFilter);
  if (dateFrom)   q.set('from', dateFrom);
  if (dateTo)     q.set('to', dateTo);
  return `/admin/logs?${q}`;
}
---

<MainLayout title="Logs de auditoría">
  <div class="mb-6 flex items-center gap-3">
    <a href="/admin" class="text-sm text-gray-500 hover:text-gray-700">← Administración</a>
    <span class="text-gray-300">/</span>
    <h1 class="text-xl font-bold text-gray-900">Logs de auditoría</h1>
  </div>

  <!-- Filtros avanzados (SSR) -->
  <form method="get" class="mb-6 rounded-2xl border border-gray-200 bg-white p-5 shadow-sm">
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <label class="mb-1 block text-xs font-medium text-gray-600">Acción</label>
        <input name="action" type="text" value={action}
          placeholder="ej: CREATE_OFFER…" class="input-field w-full text-sm" />
      </div>
      <div>
        <label class="mb-1 block text-xs font-medium text-gray-600">Usuario (nombre o email)</label>
        <input name="user" type="text" value={userFilter}
          placeholder="Buscar usuario…" class="input-field w-full text-sm" />
      </div>
      <div>
        <label class="mb-1 block text-xs font-medium text-gray-600">Desde</label>
        <input name="from" type="date" value={dateFrom} class="input-field w-full text-sm" />
      </div>
      <div>
        <label class="mb-1 block text-xs font-medium text-gray-600">Hasta</label>
        <input name="to" type="date" value={dateTo} class="input-field w-full text-sm" />
      </div>
    </div>
    <div class="mt-3 flex items-center gap-3">
      <button type="submit" class="btn-primary text-sm">Aplicar filtros</button>
      <a href="/admin/logs" class="btn-secondary text-sm">Limpiar</a>
    </div>
  </form>

  <!-- Modal de detalle del log -->
  <dialog id="log-modal" class="rounded-2xl p-8 shadow-xl w-full max-w-lg backdrop:bg-black/50">
    <div class="mb-4 flex items-start justify-between gap-4">
      <div>
        <p class="text-xs text-gray-400" id="log-modal-ts"></p>
        <h3 id="log-modal-action" class="mt-1 font-mono text-lg font-bold text-gray-900"></h3>
        <p class="text-sm text-gray-500" id="log-modal-user"></p>
      </div>
      <button id="close-log-modal" type="button" aria-label="Cerrar" class="text-gray-400 hover:text-gray-600">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>
    <pre id="log-modal-payload"
         class="overflow-auto rounded-lg bg-gray-900 p-4 text-xs leading-relaxed text-green-400 max-h-72 whitespace-pre-wrap"></pre>
  </dialog>

  <!-- Tabla -->
  <section class="rounded-2xl border border-gray-200 bg-white shadow-sm overflow-hidden">
    <div class="border-b border-gray-100 px-6 py-3 flex items-center justify-between">
      <p class="text-sm text-gray-500">
        {logsData.total} entradas · Página {logsData.page} de {logsData.totalPages}
      </p>
    </div>

    {logsData.logs.length === 0 ? (
      <p class="px-6 py-10 text-center text-sm text-gray-400">No hay logs en tu ámbito con este filtro.</p>
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-gray-50 text-left text-xs font-medium uppercase tracking-wide text-gray-500">
            <tr>
              <th class="px-6 py-3 whitespace-nowrap">Fecha y hora</th>
              <th class="px-6 py-3">Usuario</th>
              <th class="px-6 py-3">Acción</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {logsData.logs.map((l) => (
              <tr
                class="log-row cursor-pointer hover:bg-gray-50 transition-colors"
                data-timestamp={l.timestamp}
                data-action={l.action}
                data-user={`${l.user.name} (${l.user.email})`}
                data-payload={JSON.stringify(l.payload, null, 2)}
              >
                <td class="px-6 py-3 text-xs text-gray-400 whitespace-nowrap">
                  {new Date(l.timestamp).toLocaleString('es-ES', { dateStyle: 'short', timeStyle: 'medium' })}
                </td>
                <td class="px-6 py-3">
                  <p class="font-medium text-gray-800">{l.user.name}</p>
                  <p class="text-xs text-gray-400">{l.user.email}</p>
                </td>
                <td class="px-6 py-3">
                  <span class="rounded-full bg-gray-100 px-2.5 py-0.5 font-mono text-xs text-gray-700">
                    {l.action}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>

  <!-- Paginación -->
  {logsData.totalPages > 1 && (
    <div class="mt-4 flex items-center justify-center gap-2 flex-wrap">
      {logsData.page > 1 && (
        <a href={pageHref(1)} class="btn-secondary text-sm px-3 py-1.5">« Primera</a>
      )}
      {logsData.page > 1 && (
        <a href={pageHref(logsData.page - 1)} class="btn-secondary text-sm px-3 py-1.5">← Anterior</a>
      )}
      <span class="flex items-center px-3 text-sm text-gray-500">
        Página {logsData.page} de {logsData.totalPages} · {logsData.total} entradas
      </span>
      {logsData.page < logsData.totalPages && (
        <a href={pageHref(logsData.page + 1)} class="btn-secondary text-sm px-3 py-1.5">Siguiente →</a>
      )}
      {logsData.page < logsData.totalPages && (
        <a href={pageHref(logsData.totalPages)} class="btn-secondary text-sm px-3 py-1.5">Última »</a>
      )}
    </div>
  )}
</MainLayout>

<script>
  const modal          = document.getElementById('log-modal') as HTMLDialogElement;
  const closeModalBtn  = document.getElementById('close-log-modal')!;
  const modalTs        = document.getElementById('log-modal-ts')!;
  const modalAction    = document.getElementById('log-modal-action')!;
  const modalUser      = document.getElementById('log-modal-user')!;
  const modalPayload   = document.getElementById('log-modal-payload')!;

  closeModalBtn.addEventListener('click', () => modal.close());
  modal.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });

  document.querySelectorAll<HTMLTableRowElement>('.log-row').forEach((row) => {
    row.addEventListener('click', () => {
      modalTs.textContent      = new Date(row.dataset.timestamp ?? '').toLocaleString('es-ES');
      modalAction.textContent  = row.dataset.action ?? '';
      modalUser.textContent    = row.dataset.user ?? '';
      modalPayload.textContent = row.dataset.payload ?? '{}';
      modal.showModal();
    });
  });
</script>
