---
import MainLayout from '../../../layouts/MainLayout.astro';
import ChatWindow from '../../../components/tickets/ChatWindow.astro';
import { serverApi, type UserMe } from '../../../lib/api';
const api = serverApi(Astro.request);

interface UserDetail extends UserMe { name: string; }

interface Message {
  id: string;
  content: string;
  timestamp: string;
  author: { id: string; name: string };
}

interface Ticket {
  id: string;
  asunto: string;
  status: 'OPEN' | 'CLOSED';
  userId: string;
  adminId: string | null;
  user: { id: string; name: string; email: string };
  admin: { id: string; name: string } | null;
  messages: Message[];
}

let user: UserDetail | null = null;
try {
  user = await api.get<UserDetail>('/auth/me');
} catch {
  return Astro.redirect('/login');
}

const { id } = Astro.params;
let ticket: Ticket | null = null;
let messages: Message[] = [];

try {
  ticket   = await api.get<Ticket>(`/tickets/${id}`);
  messages = ticket.messages ?? [];
} catch {
  return Astro.redirect(
    user.role === 'EMBAJADOR' || user.role === 'PROPIETARIO' ? '/admin/tickets' : '/dashboard',
  );
}

const isAdmin  = user.role === 'EMBAJADOR' || user.role === 'PROPIETARIO';
const backHref = isAdmin ? '/admin/tickets' : '/dashboard';
const canClose = ticket.status === 'OPEN';
---

<MainLayout title={`Ticket: ${ticket.asunto}`}>
  <div class="mx-auto max-w-2xl">
    <div class="mb-4 flex items-center gap-3 flex-wrap">
      <a href={backHref} class="text-sm text-gray-500 hover:text-gray-700">← Volver</a>
      <span class="text-gray-300">/</span>
      <h1 class="text-lg font-bold text-gray-900 truncate max-w-xs">{ticket.asunto}</h1>
      <span class={ticket.status === 'OPEN' ? 'badge-open' : 'badge-closed'}>
        {ticket.status === 'OPEN' ? 'Abierto' : 'Cerrado'}
      </span>
    </div>

    <!-- Información del ticket -->
    <div class="mb-4 rounded-xl border border-gray-200 bg-gray-50 px-5 py-3 text-sm">
      <p class="text-gray-600">
        <span class="font-medium">Usuario:</span> {ticket.user.name}
        <span class="mx-2 text-gray-300">·</span>
        {ticket.user.email}
      </p>
      {ticket.admin && (
        <p class="mt-0.5 text-gray-400">
          Gestionado por: {ticket.admin.name}
        </p>
      )}
    </div>

    <ChatWindow
      mode="ticket"
      roomId={id!}
      currentUserId={user.id}
      currentUserName={user.name}
      messages={messages}
      canClose={canClose}
      isClosed={ticket.status === 'CLOSED'}
    />
  </div>
</MainLayout>
