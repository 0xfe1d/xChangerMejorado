---
import AuthLayout from '../layouts/AuthLayout.astro';
import { serverApi, type UserMe, type Carrera } from '../lib/api';
const api = serverApi(Astro.request);

// Redirigir si ya está autenticado
try {
  await api.get<UserMe>('/auth/me');
  return Astro.redirect('/dashboard');
} catch { /* no autenticado */ }

// Cargar lista de carreras para el desplegable (SSR — endpoint público, sin auth)
let carreras: Carrera[] = [];
try {
  carreras = await api.get<Carrera[]>('/public/careers');
} catch { /* si el backend no está disponible, el select estará vacío */ }
---

<AuthLayout title="Crear cuenta">
  <div class="rounded-2xl border border-gray-200 bg-white px-8 py-10 shadow-sm">
    <h1 class="mb-1 text-2xl font-bold text-gray-900">Crear cuenta</h1>
    <p class="mb-8 text-sm text-gray-500">
      Usa tu correo institucional <strong>@alumnos.unican.es</strong>.
    </p>

    <!-- Error global -->
    <div
      id="error-banner"
      role="alert"
      aria-live="polite"
      class="mb-5 hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"
    ></div>

    <!-- ── PASO 1: Formulario de registro ── -->
    <form id="register-form" novalidate class="space-y-5" data-step="1">
      <div>
        <label for="name" class="mb-1.5 block text-sm font-medium text-gray-700">Nombre completo</label>
        <input id="name" name="name" type="text" autocomplete="name" required
               class="input-field" placeholder="Tu nombre" />
        <p id="name-error" class="mt-1 hidden text-xs text-red-600"></p>
      </div>

      <div>
        <label for="email" class="mb-1.5 block text-sm font-medium text-gray-700">Email institucional</label>
        <input id="email" name="email" type="email" autocomplete="email" required
               class="input-field" placeholder="tu@alumnos.unican.es" />
        <p id="email-error" class="mt-1 hidden text-xs text-red-600"></p>
      </div>

      <div>
        <label for="password" class="mb-1.5 block text-sm font-medium text-gray-700">Contraseña</label>
        <div class="relative">
          <input id="password" name="password" type="password" autocomplete="new-password" required
                 class="input-field pr-10" />
          <button type="button" id="toggle-pwd" aria-label="Mostrar contraseña"
                  class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.964-7.178z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </button>
        </div>
        <!-- Indicador de requisitos de contraseña -->
        <ul id="pwd-rules" class="mt-2 space-y-1 text-xs text-gray-500" aria-label="Requisitos de contraseña">
          <li id="rule-len"  class="flex items-center gap-1.5"><span class="rule-dot h-1.5 w-1.5 rounded-full bg-gray-300"></span>Mínimo 8 caracteres</li>
          <li id="rule-upper" class="flex items-center gap-1.5"><span class="rule-dot h-1.5 w-1.5 rounded-full bg-gray-300"></span>Una letra mayúscula</li>
          <li id="rule-lower" class="flex items-center gap-1.5"><span class="rule-dot h-1.5 w-1.5 rounded-full bg-gray-300"></span>Una letra minúscula</li>
          <li id="rule-digit" class="flex items-center gap-1.5"><span class="rule-dot h-1.5 w-1.5 rounded-full bg-gray-300"></span>Un número</li>
          <li id="rule-sym"   class="flex items-center gap-1.5"><span class="rule-dot h-1.5 w-1.5 rounded-full bg-gray-300"></span>Un símbolo (!@#$…)</li>
        </ul>
        <p id="password-error" class="mt-1 hidden text-xs text-red-600"></p>
      </div>

      <div>
        <label for="confirm-password" class="mb-1.5 block text-sm font-medium text-gray-700">Confirmar contraseña</label>
        <input id="confirm-password" name="confirmPassword" type="password" autocomplete="new-password" required
               class="input-field" />
        <p id="confirm-error" class="mt-1 hidden text-xs text-red-600"></p>
      </div>

      <div>
        <label for="carrera" class="mb-1.5 block text-sm font-medium text-gray-700">Carrera</label>
        <select id="carrera" name="carreraId" required class="input-field">
          <option value="">Selecciona tu carrera…</option>
          {carreras.map((c) => (
            <option value={c.id}>{c.nombre}</option>
          ))}
        </select>
        <p id="carrera-error" class="mt-1 hidden text-xs text-red-600"></p>
      </div>

      <div>
        <label for="curso" class="mb-1.5 block text-sm font-medium text-gray-700">Curso</label>
        <select id="curso" name="cursoId" required disabled class="input-field disabled:opacity-50">
          <option value="">Selecciona primero una carrera…</option>
        </select>
        <p id="curso-error" class="mt-1 hidden text-xs text-red-600"></p>
      </div>

      <button type="submit" id="submit-btn" class="btn-primary w-full">
        Continuar
      </button>
    </form>

    <!-- ── PASO 2: Verificación OTP (modal) ── -->
    <div
      id="otp-modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="otp-title"
      class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4"
    >
      <div class="w-full max-w-sm rounded-2xl bg-white p-8 shadow-xl">
        <h2 id="otp-title" class="mb-2 text-lg font-bold text-gray-900">Verifica tu email</h2>
        <p class="mb-6 text-sm text-gray-500">
          Hemos enviado un código de 6 dígitos a tu correo. Introduce el código antes de que expire (30 min).
        </p>

        <div
          id="otp-error"
          role="alert"
          class="mb-4 hidden rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700"
        ></div>

        <div class="mb-6 flex justify-center gap-3">
          {[0,1,2,3,4,5].map((i) => (
            <input
              type="text"
              inputmode="numeric"
              maxlength="1"
              data-otp-index={i}
              class="otp-input h-12 w-10 rounded-lg border border-gray-300 text-center text-lg font-bold
                     focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/30"
              aria-label={`Dígito ${i + 1} del código OTP`}
            />
          ))}
        </div>

        <button type="button" id="verify-otp-btn" class="btn-primary w-full mb-3">
          Verificar y crear cuenta
        </button>
        <button type="button" id="back-to-form-btn" class="btn-secondary w-full text-sm">
          Volver al formulario
        </button>
      </div>
    </div>

    <p class="mt-6 text-center text-sm text-gray-500">
      ¿Ya tienes cuenta?{' '}
      <a href="/login" class="font-medium text-brand hover:underline">Iniciar sesión</a>
    </p>
  </div>
</AuthLayout>

<script>
  import { api, ApiError, type Curso } from '../lib/api';

  // ── Elementos ──────────────────────────────────────────────
  const form        = document.getElementById('register-form') as HTMLFormElement;
  const submitBtn   = document.getElementById('submit-btn') as HTMLButtonElement;
  const errorBanner = document.getElementById('error-banner')!;
  const otpModal    = document.getElementById('otp-modal')!;
  const otpError    = document.getElementById('otp-error')!;
  const verifyBtn   = document.getElementById('verify-otp-btn') as HTMLButtonElement;
  const backBtn     = document.getElementById('back-to-form-btn')!;
  const carreraSelect = document.getElementById('carrera') as HTMLSelectElement;
  const cursoSelect   = document.getElementById('curso') as HTMLSelectElement;
  const togglePwd     = document.getElementById('toggle-pwd')!;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const otpInputs = Array.from(document.querySelectorAll<HTMLInputElement>('.otp-input'));

  // ── Toggle contraseña ──────────────────────────────────────
  togglePwd.addEventListener('click', () => {
    passwordInput.type = passwordInput.type === 'password' ? 'text' : 'password';
  });

  // ── Validación visual de contraseña ───────────────────────
  const rules: Array<{ id: string; test: (v: string) => boolean }> = [
    { id: 'rule-len',   test: (v) => v.length >= 8 },
    { id: 'rule-upper', test: (v) => /[A-Z]/.test(v) },
    { id: 'rule-lower', test: (v) => /[a-z]/.test(v) },
    { id: 'rule-digit', test: (v) => /\d/.test(v) },
    { id: 'rule-sym',   test: (v) => /[!@#$%^&*()\-_=+\[\]{};':"\\|,.<>/?`~]/.test(v) },
  ];

  passwordInput.addEventListener('input', () => {
    const val = passwordInput.value;
    rules.forEach(({ id, test }) => {
      const li  = document.getElementById(id)!;
      const dot = li.querySelector('.rule-dot')!;
      if (test(val)) {
        dot.classList.replace('bg-gray-300', 'bg-green-500');
        li.classList.add('text-green-700');
        li.classList.remove('text-gray-500');
      } else {
        dot.classList.replace('bg-green-500', 'bg-gray-300');
        li.classList.remove('text-green-700');
        li.classList.add('text-gray-500');
      }
    });
  });

  // ── Carga dinámica de cursos al cambiar carrera ────────────
  carreraSelect.addEventListener('change', async () => {
    const carreraId = carreraSelect.value;
    cursoSelect.innerHTML = '<option value="">Cargando…</option>';
    cursoSelect.disabled = true;

    if (!carreraId) {
      cursoSelect.innerHTML = '<option value="">Selecciona primero una carrera…</option>';
      return;
    }

    try {
      const cursos = await api.get<Curso[]>(`/public/careers/${carreraId}/courses`);
      cursoSelect.innerHTML = '<option value="">Selecciona tu curso…</option>' +
        cursos.map((c) => `<option value="${c.id}">${c.nombre}</option>`).join('');
      cursoSelect.disabled = false;
    } catch {
      cursoSelect.innerHTML = '<option value="">Error al cargar los cursos</option>';
    }
  });

  // ── Helpers de error ───────────────────────────────────────
  function showFieldError(id: string, msg: string) {
    const el = document.getElementById(id)!;
    el.textContent = msg;
    el.classList.remove('hidden');
  }
  function clearErrors() {
    ['name-error','email-error','password-error','confirm-error','carrera-error','curso-error']
      .forEach((id) => {
        const el = document.getElementById(id)!;
        el.textContent = '';
        el.classList.add('hidden');
      });
    errorBanner.classList.add('hidden');
    errorBanner.textContent = '';
  }

  // ── Paso 1: envío del formulario → solicitar OTP ──────────
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearErrors();

    const name            = (document.getElementById('name') as HTMLInputElement).value.trim();
    const email           = (document.getElementById('email') as HTMLInputElement).value.trim();
    const password        = passwordInput.value;
    const confirmPassword = (document.getElementById('confirm-password') as HTMLInputElement).value;
    const carreraId       = carreraSelect.value;
    const cursoId         = cursoSelect.value;

    let hasError = false;
    if (!name)    { showFieldError('name-error',    'El nombre es obligatorio'); hasError = true; }
    if (!email)   { showFieldError('email-error',   'El email es obligatorio'); hasError = true; }
    if (!password){ showFieldError('password-error','La contraseña es obligatoria'); hasError = true; }
    if (password !== confirmPassword) { showFieldError('confirm-error', 'Las contraseñas no coinciden'); hasError = true; }
    if (!carreraId){ showFieldError('carrera-error', 'Selecciona tu carrera'); hasError = true; }
    if (!cursoId)  { showFieldError('curso-error',   'Selecciona tu curso'); hasError = true; }
    if (hasError) return;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Enviando…';

    try {
      await api.post('/auth/register', { name, email, password, carreraId, cursoId });
      // El backend ha fijado la cookie otp_token; mostrar el modal OTP
      otpModal.classList.remove('hidden');
      otpModal.classList.add('flex');
      otpInputs[0]?.focus();
    } catch (err) {
      if (err instanceof ApiError) {
        errorBanner.textContent = err.message;
        errorBanner.classList.remove('hidden');
      }
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Continuar';
    }
  });

  // ── Navegación entre inputs OTP ───────────────────────────
  otpInputs.forEach((input, idx) => {
    input.addEventListener('input', () => {
      // Permitir solo dígitos
      input.value = input.value.replace(/\D/g, '').slice(-1);
      if (input.value && idx < otpInputs.length - 1) {
        otpInputs[idx + 1]?.focus();
      }
    });
    input.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Backspace' && !input.value && idx > 0) {
        otpInputs[idx - 1]?.focus();
      }
    });
    // Pegar código completo
    input.addEventListener('paste', (e: ClipboardEvent) => {
      e.preventDefault();
      const digits = (e.clipboardData?.getData('text') ?? '').replace(/\D/g, '').slice(0, 6);
      digits.split('').forEach((d, i) => {
        if (otpInputs[i]) otpInputs[i].value = d;
      });
      otpInputs[Math.min(digits.length, 5)]?.focus();
    });
  });

  // ── Paso 2: verificar OTP ─────────────────────────────────
  verifyBtn.addEventListener('click', async () => {
    const otpCode = otpInputs.map((i) => i.value).join('');
    otpError.classList.add('hidden');
    otpError.textContent = '';

    if (otpCode.length !== 6 || /\D/.test(otpCode)) {
      otpError.textContent = 'Introduce los 6 dígitos del código.';
      otpError.classList.remove('hidden');
      return;
    }

    verifyBtn.disabled = true;
    verifyBtn.textContent = 'Verificando…';

    try {
      await api.post('/auth/verify-otp', { otpCode });
      // La sesión ya está activa → redirigir al dashboard
      window.location.href = '/dashboard';
    } catch (err) {
      if (err instanceof ApiError) {
        otpError.textContent = err.message;
        otpError.classList.remove('hidden');
        // Limpiar inputs para reintento
        otpInputs.forEach((i) => { i.value = ''; });
        otpInputs[0]?.focus();
      }
    } finally {
      verifyBtn.disabled = false;
      verifyBtn.textContent = 'Verificar y crear cuenta';
    }
  });

  // ── Volver al formulario ──────────────────────────────────
  backBtn.addEventListener('click', () => {
    otpModal.classList.add('hidden');
    otpModal.classList.remove('flex');
    otpInputs.forEach((i) => { i.value = ''; });
  });
</script>
