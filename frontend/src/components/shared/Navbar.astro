---
import { serverApi, type UserMe } from '../../lib/api';

// Intentamos obtener el usuario en el servidor reenviando la cookie HttpOnly
let user: UserMe | null = null;
try {
  user = await serverApi(Astro.request).get<UserMe>('/auth/me');
} catch {
  // Cookie ausente o expirada → usuario anónimo
}

const isAdmin = user?.role === 'EMBAJADOR' || user?.role === 'PROPIETARIO';
---

<nav class="border-b border-gray-200 bg-white shadow-sm">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <!-- Logotipo / nombre -->
    <a href="/" class="flex items-center gap-2 text-lg font-bold text-brand">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"
        />
      </svg>
      xChanger
    </a>

    <!-- Zona derecha: campana + menú -->
    <div class="flex items-center gap-2">
    {user && (
      <!-- Campana de notificaciones -->
      <a
        href="/notifications"
        id="notif-bell"
        aria-label="Notificaciones"
        class="relative rounded-full p-1.5 text-gray-500 transition-colors hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-brand/40"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24"
             stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
        </svg>
        <!-- Badge: se muestra sólo si hay no leídas (gestionado por JS) -->
        <span
          id="notif-badge"
          class="absolute -right-0.5 -top-0.5 hidden min-w-[1.1rem] items-center justify-center rounded-full bg-red-500 px-1 py-0.5 text-[0.6rem] font-bold leading-none text-white"
        ></span>
      </a>
    )}

    <!-- Menú de usuario -->
    <div class="relative" id="user-menu-container">
      <button
        id="user-menu-btn"
        type="button"
        aria-haspopup="true"
        aria-expanded="false"
        aria-label="Menú de usuario"
        class="flex items-center gap-2 rounded-full p-1.5 text-gray-600 transition-colors hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-brand/40"
      >
        <!-- Icono de usuario -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-7 w-7"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M17.982 18.725A7.488 7.488 0 0012 15.75a7.488 7.488 0 00-5.982 2.975m11.963 0a9 9 0 10-11.963 0m11.963 0A8.966 8.966 0 0112 21a8.966 8.966 0 01-5.982-2.275M15 9.75a3 3 0 11-6 0 3 3 0 016 0z"
          />
        </svg>
        {user && <span class="hidden text-sm font-medium sm:block">{user.email}</span>}
      </button>

      <!-- Desplegable -->
      <div
        id="user-dropdown"
        role="menu"
        aria-labelledby="user-menu-btn"
        class="absolute right-0 z-50 mt-2 hidden w-52 origin-top-right rounded-xl border border-gray-200 bg-white py-1 shadow-lg"
      >
        {user ? (
          <>
            <a
              href="/dashboard"
              role="menuitem"
              class="flex items-center gap-2 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50"
            >
              <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
              Panel de usuario
            </a>
            <a
              href="/settings"
              role="menuitem"
              class="flex items-center gap-2 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50"
            >
              <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              Ajustes
            </a>
            {isAdmin && (
              <a
                href="/admin"
                role="menuitem"
                class="flex items-center gap-2 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50"
              >
                <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                Administración
              </a>
            )}
            <hr class="my-1 border-gray-100" />
            <button
              id="logout-btn"
              role="menuitem"
              type="button"
              class="flex w-full items-center gap-2 px-4 py-2.5 text-sm text-red-600 hover:bg-red-50"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
              </svg>
              Cerrar sesión
            </button>
          </>
        ) : (
          <a
            href="/login"
            role="menuitem"
            class="flex items-center gap-2 px-4 py-2.5 text-sm font-medium text-brand hover:bg-brand/5"
          >
            Iniciar sesión
          </a>
        )}
      </div>
    </div>
    </div><!-- fin flex items-center gap-2 -->
  </div>
</nav>

<script>
  import { api } from '../../lib/api';
  import { disconnectSocket } from '../../lib/socket';

  const btn = document.getElementById('user-menu-btn')!;
  const dropdown = document.getElementById('user-dropdown')!;
  const logoutBtn = document.getElementById('logout-btn');

  // Toggle del menú desplegable
  btn.addEventListener('click', () => {
    const isOpen = dropdown.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(isOpen));
  });

  // Cerrar al hacer click fuera
  document.addEventListener('click', (e) => {
    if (!document.getElementById('user-menu-container')!.contains(e.target as Node)) {
      dropdown.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
    }
  });

  // Logout
  logoutBtn?.addEventListener('click', async () => {
    try {
      await api.post('/auth/logout');
    } finally {
      disconnectSocket();
      window.location.href = '/login';
    }
  });

  // Badge de notificaciones no leídas (solo si hay sesión activa)
  const badge = document.getElementById('notif-badge');
  if (badge) {
    api.get<{ count: number }>('/notifications/unread-count')
      .then(({ count }) => {
        if (count > 0) {
          badge.textContent = count > 99 ? '99+' : String(count);
          badge.classList.remove('hidden');
          badge.classList.add('flex');
        }
      })
      .catch(() => { /* silencioso si no hay sesión */ });
  }
</script>
