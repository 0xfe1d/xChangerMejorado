---
// Sin lógica de servidor; el footer es estático
---

<footer class="mt-auto border-t border-gray-200 bg-white">
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-between">
      <!-- Logo UC -->
      <a
        href="https://www.unican.es"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-3 opacity-80 transition-opacity hover:opacity-100"
        aria-label="Universidad de Cantabria"
      >
        <img
          src="/logo.jpg"
          alt="Logo Universidad de Cantabria"
          width="120"
          height="40"
          class="h-10 w-auto object-contain"
        />
      </a>

      <!-- Aviso legal central -->
      <p class="max-w-md text-center text-xs leading-relaxed text-gray-500">
        Esta web <strong>no tiene carácter oficial</strong> ni ha sido creada por la
        Universidad de Cantabria. Su único propósito es facilitar la coordinación
        del alumnado para el cambio de grupos.
      </p>

      <!-- Créditos -->
      <p class="text-xs text-gray-400">
        Creado por <span class="font-medium text-gray-600">Asier Del Cid Pérez</span>
      </p>
    </div>
  </div>
</footer>
