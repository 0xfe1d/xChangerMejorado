# ─────────────────────────────────────────────────────────────
# xChanger — Variables del docker-compose (raíz del proyecto)
# Copia este fichero como .env y rellena los valores reales.
#
#   cp .env.example .env
#
# IMPORTANTE: los valores de POSTGRES_* deben coincidir exactamente
# con los que uses en DATABASE_URL dentro de backend/.env.
# ─────────────────────────────────────────────────────────────

# ── URL de la aplicación ──────────────────────────────────────
# Cambia estos dos valores según el entorno:
#   Producción:  APP_URL=https://xchanger-uc.xyz   APP_HOST=xchanger-uc.xyz
#   Localhost:   APP_URL=http://localhost           APP_HOST=localhost
APP_URL=https://xchanger-uc.xyz
APP_HOST=xchanger-uc.xyz
# URL pública exacta que Telegram usará para enviar updates al bot.
# Si cambia el dominio o la ruta, modifica esta variable.
TELEGRAM_WEBHOOK_URL=https://xchanger-uc.xyz/telegram/webhook

# ── HTTPS ─────────────────────────────────────────────────────
# true  → nginx sirve HTTPS + redirige HTTP→HTTPS (requiere certs en /etc/letsencrypt)
# false → nginx sirve solo HTTP (desarrollo local)
ENABLE_HTTPS=true

# Email para Let's Encrypt (avisos de caducidad). Necesario si ENABLE_HTTPS=true
CERTBOT_EMAIL=cambiar.grupos.informatica@gmail.com

# Debe ser true cuando APP_URL usa https://, false en localhost
COOKIE_SECURE=true

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=xchanger_user
POSTGRES_PASSWORD=CAMBIA_ESTO_POR_UNA_CONTRASEÑA_MUY_SEGURA
POSTGRES_DB=xchanger_db

# ── MFA (mfa-service) ─────────────────────────────────────────
# Clave de cifrado de los secretos TOTP (32 bytes en hex): openssl rand -hex 32
MFA_KEK=CAMBIA_ESTO_POR_64_CARACTERES_HEX
# true en producción (el QR solo se muestra por HTTPS); false para probar en http://localhost
MFA_REQUIRE_HTTPS=true

# ── Telegram Bot y bot-db (Escalado §12.3) ────────────────────
BOT_POSTGRES_USER=xchanger_bot
BOT_POSTGRES_PASSWORD=xchanger_bot_dev_password
BOT_POSTGRES_DB=xchanger_bot
TG_USE_MOCK_CORE=false
# Endpoint del servidor Core para el bot:
# - Dentro del stack completo de Docker Compose: http://backend:3000/api/v1
# - Apuntando a un servidor externo (ajustable): https://xchanger-uc.xyz (o https://xchanger-uc.xyz/api/v1)
CORE_API_URL=http://backend:3000/api/v1
TELEGRAM_BOT_MODE=webhook
TELEGRAM_BOT_TOKEN=0000000000:example-botfather-token
TELEGRAM_WEBHOOK_SECRET=example-webhook-secret-token-value
SERVICE_CLIENT_ID=telegram-bot
SERVICE_CLIENT_SECRET=example-service-client-secret-minimum-32-chars
TOKEN_ENC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
