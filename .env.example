# ─────────────────────────────────────────────────────────────
# xChanger — Variables del docker-compose (raíz del proyecto)
# Copia este fichero como .env y rellena los valores reales.
#
#   cp .env.example .env
#
# IMPORTANTE: los valores de POSTGRES_* deben coincidir exactamente
# con los que uses en DATABASE_URL dentro de backend/.env.
# ─────────────────────────────────────────────────────────────

# ── URL de la aplicación ──────────────────────────────────────
# Cambia estos dos valores según el entorno:
#   Producción:  APP_URL=https://xchanger-uc.xyz   APP_HOST=xchanger-uc.xyz
#   Localhost:   APP_URL=http://localhost           APP_HOST=localhost
APP_URL=https://xchanger-uc.xyz
APP_HOST=xchanger-uc.xyz

# ── HTTPS ─────────────────────────────────────────────────────
# true  → nginx sirve HTTPS + redirige HTTP→HTTPS (requiere certs en /etc/letsencrypt)
# false → nginx sirve solo HTTP (desarrollo local)
ENABLE_HTTPS=true

# Email para Let's Encrypt (avisos de caducidad). Necesario si ENABLE_HTTPS=true
CERTBOT_EMAIL=cambiar.grupos.informatica@gmail.com

# Debe ser true cuando APP_URL usa https://, false en localhost
COOKIE_SECURE=true

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=xchanger_user
POSTGRES_PASSWORD=CAMBIA_ESTO_POR_UNA_CONTRASEÑA_MUY_SEGURA
POSTGRES_DB=xchanger_db
