# ─────────────────────────────────────────────────────────────
# xChanger — Variables del docker-compose (raíz del proyecto)
# Copia este fichero como .env y rellena los valores reales.
#
#   cp .env.example .env
#
# IMPORTANTE: los valores de POSTGRES_* deben coincidir exactamente
# con los que uses en DATABASE_URL dentro de backend/.env.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=xchanger_user
POSTGRES_PASSWORD=CAMBIA_ESTO_POR_UNA_CONTRASEÑA_MUY_SEGURA
POSTGRES_DB=xchanger_db
