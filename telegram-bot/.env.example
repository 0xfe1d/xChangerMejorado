# ── Telegram Bot API ──────────────────────────────────────────
# Token que te da @BotFather en Telegram
TELEGRAM_BOT_TOKEN=PON_AQUI_TU_TOKEN_DE_BOTFATHER

# Secreto para validar el webhook en producción (1-256 chars A-Za-z0-9_-)
TELEGRAM_WEBHOOK_SECRET=secreto-local-desarrollo-123456

# ── Modo de desarrollo ────────────────────────────────────────
# true  = usa datos en memoria (no ocupa core, Redis ni Postgres)
# false = usa el core real + Redis + bot-db
USE_MOCK_CORE=true
NODE_ENV=development
PORT=8080

# ── Conexión con el Core (necesario cuando USE_MOCK_CORE=false) ──
CORE_API_URL=http://localhost:4000/api/v1
SERVICE_CLIENT_ID=telegram-bot
SERVICE_CLIENT_SECRET=

# ── Redis y BD del bot (necesario cuando USE_MOCK_CORE=false) ───
REDIS_URL=redis://localhost:6379/0
BOT_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/xchanger_bot?sslmode=disable
# Clave AES-256 (32 bytes en base64) para cifrar refresh tokens
TOKEN_ENC_KEY=

